<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="1757116800-011-criar-tb-agendas" author="igor">
        <createTable tableName="TB_AGENDAS" schemaName="agd" remarks="Agendas concretas de atendimento geradas a partir de escalas">
            <column name="COD_AGENDA" type="INT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="PK_TB_AGENDAS" nullable="false"/>
            </column>
            <column name="COD_ESCALA" type="INT">
                <constraints nullable="false"
                             foreignKeyName="FK_TB_AGENDAS_COD_ESCALA"
                             references="agd.TB_ESCALAS(COD_ESCALA)"/>
            </column>
            <column name="DT_AGENDA" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="IC_DIA_SEMANA" type="VARCHAR(10)">
                <constraints nullable="false"
                             checkConstraint="IC_DIA_SEMANA IN ('DOMINGO','SEGUNDA','TERCA','QUARTA','QUINTA','SEXTA','SABADO')"/>
            </column>
            <column name="HR_HORA_INICIO" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="HR_HORA_FIM" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="COD_ESTABELECIMENTO" type="INT">
                <constraints nullable="false"
                             foreignKeyName="FK_TB_AGENDAS_COD_ESTABELECIMENTO"
                             references="agd.TB_ESTABELECIMENTOS(COD_ESTABELECIMENTO)"/>
            </column>
            <column name="COD_PROFISSIONAL_VINCULO" type="INT">
                <constraints nullable="false"
                             foreignKeyName="FK_TB_AGENDAS_COD_PROFISSIONAL_VINCULO"
                             references="agd.TB_PROFISSIONAL_VINCULOS(COD_PROFISSIONAL_VINCULO)"/>
            </column>
            <column name="DH_INSERT" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="DH_ATUALIZACAO" type="TIMESTAMP"/>
        </createTable>

        <createIndex indexName="IDX_TB_AGENDAS_COD_PROFISSIONAL_VINCULO"
                     tableName="TB_AGENDAS" schemaName="agd">
            <column name="COD_PROFISSIONAL_VINCULO"/>
        </createIndex>

        <createIndex indexName="IDX_TB_AGENDAS_DT_AGENDA"
                     tableName="TB_AGENDAS" schemaName="agd">
            <column name="DT_AGENDA"/>
        </createIndex>

        <rollback>
            <dropTable tableName="TB_AGENDAS" schemaName="agd"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
