<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="1757116800-010-criar-tb-escala-itens" author="igor">
        <createTable tableName="TB_REL_ESCALA_ITEM" schemaName="agd">
            <column name="COD_ESCALA_ITEM" type="INT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="PK_TB_REL_ESCALA_ITEM" nullable="false"/>
            </column>
            <column name="COD_ESCALA" type="INT">
                <constraints nullable="false"
                             foreignKeyName="FK_TB_REL_ESCALA_ITEM_COD_ESCALA"
                             references="agd.TB_ESCALAS(COD_ESCALA)"/>
            </column>
            <column name="COD_SERVICO" type="INT">
                <constraints nullable="false"
                             foreignKeyName="FK_TB_REL_ESCALA_ITEM_COD_SERVICO"
                             references="agd.TB_SERVICOS(COD_SERVICO)"/>
            </column>
            <column name="IC_ATIVA" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="DH_INSERT" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="DH_ATUALIZACAO" type="TIMESTAMP"/>
        </createTable>

        <createIndex indexName="IDX_TB_REL_ESCALA_ITEM_COD_ESCALA"
                     tableName="TB_REL_ESCALA_ITEM" schemaName="agd">
            <column name="COD_ESCALA"/>
        </createIndex>

        <rollback>
            <dropTable tableName="TB_REL_ESCALA_ITEM" schemaName="agd"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
